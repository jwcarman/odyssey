<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jwcarman.odyssey</groupId>
        <artifactId>odyssey-parent</artifactId>
        <version>0.12.0-SNAPSHOT</version>
    </parent>

    <artifactId>odyssey-example</artifactId>
    <name>Odyssey Example Application</name>
    <description>Example Spring Boot application demonstrating Odyssey</description>

    <properties>
        <!-- A demonstration, not a library: never published, never measured for coverage. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <skipPublishing>true</skipPublishing>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
        <jacoco.skip>true</jacoco.skip>
        <sonar.skip>true</sonar.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jwcarman.odyssey</groupId>
            <artifactId>odyssey</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          codec 0.10.0 moved the codec auto-configurations out of the provider modules into
          codec-autoconfigure. codec-jackson now ships the factory only, so without this the
          application starts with no CodecFactory bean — and substrate's JournalFactory is
          @ConditionalOnBean(CodecFactory), so the failure surfaces as a missing JournalFactory.
        -->
        <dependency>
            <groupId>org.jwcarman.codec</groupId>
            <artifactId>codec-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.substrate</groupId>
            <artifactId>substrate-redis</artifactId>
        </dependency>
        <!--
          substrate-crypto wires a PayloadTransformer that encrypts journal payloads at rest.
          It's a no-op by default; set substrate.crypto.shared-key in application.yml to
          turn on AES-GCM encryption. See the comment in application.yml for details.
        -->
        <dependency>
            <groupId>org.jwcarman.substrate</groupId>
            <artifactId>substrate-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <image>
                        <name>odyssey-example:local</name>
                    </image>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
